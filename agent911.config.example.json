{
  "schema_version": 2,
  "workspace_root": ".",
  "data_dir": ".agent911",
  "database_path": ".agent911/agent911.db",
  "custom_capabilities_dir": ".agent911/custom_capabilities",
  "max_recovery_attempts_per_step": 2,
  "command_timeout_seconds": 20.0,
  "max_context_chars": 16000,
  "allow_local_fallback": true,
  "default_model": "default",
  "active_model": "default",
  "fallback_model": "local-planner",
  "providers": {
    "default": {
      "provider_id": "default",
      "name": "Default OpenAI-Compatible Provider",
      "adapter_type": "openai_compatible",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "api_key_env": "AGENT911_API_KEY",
      "enabled": true,
      "custom_headers": {},
      "description": "Primary OpenAI-compatible chat completions endpoint"
    },
    "anthropic": {
      "provider_id": "anthropic",
      "name": "Anthropic Messages API",
      "adapter_type": "anthropic",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "api_key_env": "ANTHROPIC_API_KEY",
      "enabled": true,
      "custom_headers": {},
      "description": "Anthropic Messages v1 provider"
    },
    "groq": {
      "provider_id": "groq",
      "name": "Groq OpenAI-Compatible API (Free Tier)",
      "adapter_type": "openai_compatible",
      "endpoint": "https://api.groq.com/openai/v1/chat/completions",
      "api_key_env": "GROQ_API_KEY",
      "enabled": true,
      "custom_headers": {},
      "description": "Groq Cloud free-tier OpenAI-compatible inference endpoint"
    },
    "ollama_local": {
      "provider_id": "ollama_local",
      "name": "Local Ollama Server",
      "adapter_type": "ollama",
      "endpoint": "http://127.0.0.1:11434/api/chat",
      "api_key_env": null,
      "enabled": true,
      "custom_headers": {},
      "description": "Local Ollama inference server"
    },
    "local_heuristic": {
      "provider_id": "local_heuristic",
      "name": "Local Heuristic Engine",
      "adapter_type": "local_only",
      "endpoint": "local://heuristic",
      "api_key_env": null,
      "enabled": true,
      "custom_headers": {},
      "description": "Built-in offline instruction parser and planner"
    }
  },
  "models": {
    "default": {
      "profile_id": "default",
      "name": "GPT-4o Mini (Default)",
      "provider_id": "default",
      "model_id": "gpt-4o-mini",
      "endpoint_override": null,
      "context_window_tokens": 128000,
      "supported_inputs": ["text"],
      "supports_tool_calling": true,
      "supports_structured_output": true,
      "supports_streaming": true,
      "temperature": 0.1,
      "max_tokens": 2048,
      "timeout_seconds": 30.0,
      "max_retries": 1,
      "enabled": true
    },
    "claude-sonnet": {
      "profile_id": "claude-sonnet",
      "name": "Claude 3.5 Sonnet",
      "provider_id": "anthropic",
      "model_id": "claude-3-5-sonnet-latest",
      "endpoint_override": null,
      "context_window_tokens": 200000,
      "supported_inputs": ["text"],
      "supports_tool_calling": true,
      "supports_structured_output": true,
      "supports_streaming": true,
      "temperature": 0.1,
      "max_tokens": 2048,
      "timeout_seconds": 30.0,
      "max_retries": 1,
      "enabled": true
    },
    "groq-llama-3.1-8b-instant": {
      "profile_id": "groq-llama-3.1-8b-instant",
      "name": "Groq Llama 3.1 8B Instant (Free Tier)",
      "provider_id": "groq",
      "model_id": "llama-3.1-8b-instant",
      "endpoint_override": null,
      "context_window_tokens": 131072,
      "supported_inputs": ["text"],
      "supports_tool_calling": true,
      "supports_structured_output": true,
      "supports_streaming": true,
      "temperature": 0.1,
      "max_tokens": 2048,
      "timeout_seconds": 30.0,
      "max_retries": 1,
      "enabled": true
    },
    "groq-llama-3.3-70b-versatile": {
      "profile_id": "groq-llama-3.3-70b-versatile",
      "name": "Groq Llama 3.3 70B Versatile (Free Tier)",
      "provider_id": "groq",
      "model_id": "llama-3.3-70b-versatile",
      "endpoint_override": null,
      "context_window_tokens": 131072,
      "supported_inputs": ["text"],
      "supports_tool_calling": true,
      "supports_structured_output": true,
      "supports_streaming": true,
      "temperature": 0.1,
      "max_tokens": 2048,
      "timeout_seconds": 30.0,
      "max_retries": 1,
      "enabled": true
    },
    "local-planner": {
      "profile_id": "local-planner",
      "name": "Local Planner Model",
      "provider_id": "local_heuristic",
      "model_id": "local-heuristic-v1",
      "endpoint_override": "local://heuristic",
      "context_window_tokens": 4096,
      "supported_inputs": ["text"],
      "supports_tool_calling": false,
      "supports_structured_output": true,
      "supports_streaming": false,
      "temperature": 0.1,
      "max_tokens": 2048,
      "timeout_seconds": 10.0,
      "max_retries": 0,
      "enabled": true
    }
  }
}
